# ──────────────────────────────────────────────────────────────
# FAIRPOOL environment. Copy to `.env.local` and fill in.
# `.env.local` is gitignored — never commit real keys.
# The app runs with ZERO setup in local demo mode (AUTH_MODE=local).
# ──────────────────────────────────────────────────────────────

# Auth mode: "local" (in-browser demo) or "clerk" (Clerk-hosted auth)
NEXT_PUBLIC_AUTH_MODE=local

# ── Clerk (only needed when AUTH_MODE=clerk) ──
# From dashboard.clerk.com → API keys → choose "Next.js"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Route Clerk's hosted pages to our custom catch-all routes:
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Clerk webhook signing secret (from dashboard.clerk.com → Webhooks → signing secret)
# Used by /api/webhook/clerk to sync users to Supabase profiles.
CLERK_WEBHOOK_SECRET=

# ── Maps ──
# Optional. The voting map now uses Leaflet + free OpenStreetMap/CartoDB tiles
# (no key required). This is only kept for an optional MapTiler upgrade.
NEXT_PUBLIC_MAPTILER_KEY=

# ── Supabase (optional production data layer) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Security ──
# AES-256 key for field-level encryption at rest (src/lib/server/crypto.ts).
# Generate: `openssl rand -base64 32`  → produces a 32-byte base64 key.
# In production load this from AWS KMS / HashiCorp Vault, NOT a plain file.
ENCRYPTION_KEY=

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Session JWT signing secret — use a long random string (openssl rand -hex 32).
SESSION_SECRET=change-me-to-a-long-random-string
